{
  "name": "radar-clients",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ops": "npm run app -w @radar/ops",
    "user": "npm run app -w @radar/user",
    "web:ops": "npm run dev -w @radar/ops",
    "web:user": "npm run dev -w @radar/user",
    "build:ops": "npm run bundle -w @radar/ops",
    "build:user": "npm run bundle -w @radar/user",
    "typecheck": "npm run build -w @radar/ops -w @radar/user --if-present"
  }
}
