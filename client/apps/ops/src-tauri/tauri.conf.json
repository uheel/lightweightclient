{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightClient_Ops",
  "version": "0.1.6",
  "identifier": "com.igoodlife.radar.ops",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radar Config",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "theme": "Light",
        "windowEffects": { "effects": ["tabbed"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRTMyMDI1Q0EwNDEyQ0QKUldUTkVnVEtKU0RqMG05bkFpSysyMVVtTHd0a1hoeTRuRFhpSnA4ZGRkZ3RWbXJMMDVFVGU0TS8K",
      "endpoints": ["https://update.uheel.one/ops/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
